import builtins
from typing import (
    Any,
    Callable,
    Dict,
    List,
    Literal,
    NotRequired,
    Optional,
    Sequence,
    Tuple,
    TypedDict,
    Union,
    type_check_only,
)

from xapi import *
from xapi.storage.api.v5.volume import Blocklist

get_str = str
long = int
unicode = str
# Annotations use `builtins.str`: `str` is `bytes` in this module.
str = bytes

# ==============================================================================
# Types of the IDL (`data.ml`), for typing only.
# ==============================================================================

# Record `xendisk`.
@type_check_only
class XenDisk(TypedDict):
    # Put into the `params` key in xenstore.
    params: builtins.str
    # Put into the `sm-data` directory of the xenstore backend.
    extra: Dict[builtins.str, builtins.str]
    # Xenstore directory of the backend, e.g. `qdisk`.
    backend_type: builtins.str

# Record `block_device`.
@type_check_only
class BlockDevice(TypedDict):
    path: builtins.str

# Record `file`.
@type_check_only
class File(TypedDict):
    path: builtins.str

# Record `nbd`.
@type_check_only
class Nbd(TypedDict):
    # `nbd:unix:<domain-socket>:exportname=<NAME>`.
    uri: builtins.str

# Variant `implementation`: `(tag, record)`, the record of the tag (`("XenDisk", XenDisk)`...).
# Not a union of tuples: mypy cannot infer a tuple literal against it.
DatapathImplementation = Tuple[Literal["XenDisk", "BlockDevice", "File", "Nbd"], Union[XenDisk, BlockDevice, File, Nbd]]

# Record `backend`.
@type_check_only
class Backend(TypedDict):
    implementations: List[DatapathImplementation]

# Variant `operation` of `Data`, as returned by an implementation: `(tag, key)`.
# Received as a `[tag, key]` list (decoded from JSON), hence `Sequence[str]` for the parameters.
Operation = Tuple[Literal["CopyV1", "MirrorV1"], builtins.str]

# Record `status` of `Data`.
@type_check_only
class Status(TypedDict):
    failed: bool
    complete: bool
    # From 0 to 1, for a copy operation.
    progress: NotRequired[float]

_Arguments = Dict[builtins.str, Any]

# ==============================================================================
# Datapath.
# ==============================================================================

# Checks the arguments and the result of the implementation.
class Datapath_server_dispatcher:
    _impl: Union[Datapath_skeleton, Datapath_test]
    _dispatcher_dict: Dict[builtins.str, Callable[[_Arguments], Any]]
    def __init__(self, impl: Union[Datapath_skeleton, Datapath_test]) -> None: ...
    def open(self, args: _Arguments) -> None: ...
    def attach(self, args: _Arguments) -> Backend: ...
    def activate(self, args: _Arguments) -> None: ...
    def activate_readonly(self, args: _Arguments) -> None: ...
    def import_activate(self, args: _Arguments) -> builtins.str: ...
    def deactivate(self, args: _Arguments) -> None: ...
    def detach(self, args: _Arguments) -> None: ...
    def close(self, args: _Arguments) -> None: ...
    def _dispatch(self, method: builtins.str, params: Sequence[_Arguments]) -> Dict[builtins.str, Any]: ...

# Every method raises `Unimplemented`.
class Datapath_skeleton:
    def __init__(self) -> None: ...
    def open(self, dbg: builtins.str, uri: builtins.str, persistent: bool) -> None: ...
    def attach(self, dbg: builtins.str, uri: builtins.str, domain: builtins.str) -> Backend: ...
    def activate(self, dbg: builtins.str, uri: builtins.str, domain: builtins.str) -> None: ...
    def activate_readonly(self, dbg: builtins.str, uri: builtins.str, domain: builtins.str) -> None: ...
    # Returns the path of a UNIX domain socket.
    def import_activate(self, dbg: builtins.str, uri: builtins.str, domain: builtins.str) -> builtins.str: ...
    def deactivate(self, dbg: builtins.str, uri: builtins.str, domain: builtins.str) -> None: ...
    def detach(self, dbg: builtins.str, uri: builtins.str, domain: builtins.str) -> None: ...
    def close(self, dbg: builtins.str, uri: builtins.str) -> None: ...

