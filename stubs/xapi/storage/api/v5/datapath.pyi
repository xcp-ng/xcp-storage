# ==============================================================================
# Demultiplexer of the `Datapath.*` and `Data.*` methods.
# ==============================================================================

class datapath_server_dispatcher:
    Datapath: Datapath_server_dispatcher
    Data: Data_server_dispatcher
    _dispatcher_dict: Dict[builtins.str, Callable[[builtins.str, Sequence[_Arguments]], Dict[builtins.str, Any]]]
    # `None` raises `AttributeError`.
    def __init__(
        self,
        Datapath: Optional[Datapath_server_dispatcher] = None,
        Data: Optional[Data_server_dispatcher] = None
    ) -> None: ...
    # Returns the JSON-RPC response: errors are returned, not raised.
    def _dispatch(self, method: builtins.str, params: Sequence[_Arguments]) -> Dict[builtins.str, Any]: ...

class datapath_server_test(datapath_server_dispatcher):
    def __init__(self) -> None: ...
