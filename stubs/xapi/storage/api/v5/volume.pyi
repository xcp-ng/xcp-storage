import builtins
from _typeshed import Incomplete
from typing import (
    Any,
    Callable,
    Dict,
    List,
    Literal,
    NotRequired,
    Optional,
    Sequence,
    Tuple,
    TypedDict,
    Union,
    type_check_only,
)

from xapi import *

get_str = str
long = int
unicode = str
# Annotations use `builtins.str`: `str` is `bytes` in this module.
str = bytes

# ==============================================================================
# Types of the IDL (`control.ml`, `common.ml`), for typing only.
# ==============================================================================

# Variant `health`: `(tag, message)`.
Health = Tuple[Literal["Healthy", "Recovering", "Unreachable", "Unavailable"], builtins.str]

# Variant `volume_type` (constant constructors): `(tag,)`.
VolumeType = Tuple[Literal["Data", "CBT_Metadata", "Data_and_CBT_Metadata"]]

# Record `sr_stat`.
@type_check_only
class SrStat(TypedDict):
    sr: builtins.str
    name: builtins.str
    uuid: NotRequired[builtins.str]
    description: builtins.str
    free_space: int
    total_space: int
    datasources: List[builtins.str]
    clustered: bool
    health: Health

# Record `volume`.
@type_check_only
class Volume(TypedDict):
    key: builtins.str
    uuid: NotRequired[builtins.str]
    name: builtins.str
    description: builtins.str
    read_write: bool
    sharable: bool
    virtual_size: int
    physical_utilisation: int
    uri: List[builtins.str]
    keys: Dict[builtins.str, builtins.str]
    # `Data` if absent.
    volume_type: NotRequired[VolumeType]
    # `False` if absent.
    cbt_enabled: NotRequired[bool]

# Record `changed_blocks`.
@type_check_only
class ChangedBlocks(TypedDict):
    granularity: int
    # Base64-encoded bitmap.
    bitmap: builtins.str

# Record `blocklist` of `common.ml`: ranges are `(start, length)` tuples in units of `blocksize`.
@type_check_only
class Blocklist(TypedDict):
    blocksize: int
    ranges: List[Tuple[int, int]]

# Record `probe_result`.
@type_check_only
class ProbeResult(TypedDict):
    configuration: Dict[builtins.str, builtins.str]
    complete: bool
    sr: NotRequired[SrStat]
    extra_info: Dict[builtins.str, builtins.str]

_Arguments = Dict[builtins.str, Any]

# ==============================================================================
# Errors.
# ==============================================================================

class Sr_not_attached(Rpc_light_failure):
    arg_0: builtins.str
    def __init__(self, arg_0: builtins.str) -> None: ...

class SR_does_not_exist(Rpc_light_failure):
    arg_0: builtins.str
    def __init__(self, arg_0: builtins.str) -> None: ...

class Volume_does_not_exist(Rpc_light_failure):
    arg_0: builtins.str
    def __init__(self, arg_0: builtins.str) -> None: ...

class Cancelled(Rpc_light_failure):
    arg_0: builtins.str
    def __init__(self, arg_0: builtins.str) -> None: ...

class Activated_on_another_host(Rpc_light_failure):
    arg_0: builtins.str
    def __init__(self, arg_0: builtins.str) -> None: ...

