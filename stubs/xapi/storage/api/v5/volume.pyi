# Checks the arguments and the result of the implementation.
class SR_server_dispatcher:
    _impl: Union[SR_skeleton, SR_test]
    _dispatcher_dict: Dict[builtins.str, Callable[[_Arguments], Any]]
    def __init__(self, impl: Union[SR_skeleton, SR_test]) -> None: ...
    def probe(self, args: _Arguments) -> List[ProbeResult]: ...
    def create(self, args: _Arguments) -> Dict[builtins.str, builtins.str]: ...
    def attach(self, args: _Arguments) -> builtins.str: ...
    def detach(self, args: _Arguments) -> None: ...
    def destroy(self, args: _Arguments) -> None: ...
    def stat(self, args: _Arguments) -> SrStat: ...
    def set_name(self, args: _Arguments) -> None: ...
    def set_description(self, args: _Arguments) -> None: ...
    def ls(self, args: _Arguments) -> List[Volume]: ...
    def _dispatch(self, method: builtins.str, params: Sequence[_Arguments]) -> Dict[builtins.str, Any]: ...

# Every method raises `Unimplemented`.
class SR_skeleton:
    def __init__(self) -> None: ...
    def probe(self, dbg: builtins.str, configuration: Dict[builtins.str, builtins.str]) -> List[ProbeResult]: ...
