    # Returns the `sr` key used by the other calls.
    def attach(self, dbg: builtins.str, configuration: Dict[builtins.str, builtins.str]) -> builtins.str: ...
    def detach(self, dbg: builtins.str, sr: builtins.str) -> None: ...
    def destroy(self, dbg: builtins.str, sr: builtins.str) -> None: ...
    def stat(self, dbg: builtins.str, sr: builtins.str) -> SrStat: ...
    def set_name(self, dbg: builtins.str, sr: builtins.str, new_name: builtins.str) -> None: ...
    def set_description(self, dbg: builtins.str, sr: builtins.str, new_description: builtins.str) -> None: ...
    def ls(self, dbg: builtins.str, sr: builtins.str) -> List[Volume]: ...

