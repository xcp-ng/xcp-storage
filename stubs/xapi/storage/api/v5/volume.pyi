# ==============================================================================
# Demultiplexer of the `SR.*` and `Volume.*` methods.
# ==============================================================================

class volume_server_dispatcher:
    SR: SR_server_dispatcher
    Volume: Volume_server_dispatcher
    _dispatcher_dict: Dict[builtins.str, Callable[[builtins.str, Sequence[_Arguments]], Dict[builtins.str, Any]]]
    # `None` raises `AttributeError`.
    def __init__(
        self,
        SR: Optional[SR_server_dispatcher] = None,
        Volume: Optional[Volume_server_dispatcher] = None
    ) -> None: ...
    # Returns the JSON-RPC response: errors are returned, not raised.
    def _dispatch(self, method: builtins.str, params: Sequence[_Arguments]) -> Dict[builtins.str, Any]: ...

class volume_server_test(volume_server_dispatcher):
    def __init__(self) -> None: ...
