from _typeshed import Incomplete
from typing import List, Optional

from .responses import ApiCallResponse

class LinstorError(Exception):
    _msg: str
    _errors: Incomplete
    def __init__(self, msg: str, all_errors=None) -> None: ...
    def all_errors(self): ...
    @property
    def message(self) -> str: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class LinstorNetworkError(LinstorError):
    def __init__(self, msg: str, more_errors=None) -> None: ...

class LinstorTimeoutError(LinstorError):
    def __init__(self, msg: str, more_errors=None) -> None: ...

class LinstorApiCallError(LinstorError):
    _main_error: ApiCallResponse
    def __init__(
        self,
        apicallresponse: ApiCallResponse,
        all_errors: Optional[List[ApiCallResponse]] = None
    ) -> None: ...
    @property
    def main_error(self) -> ApiCallResponse: ...

class LinstorArgumentError(LinstorError):
    def __init__(self, msg: str, more_errors=None) -> None: ...

class LinstorReadOnlyAfterSetError(LinstorError):
    def __init__(self, msg: Optional[str] = None, more_errors=None) -> None: ...
