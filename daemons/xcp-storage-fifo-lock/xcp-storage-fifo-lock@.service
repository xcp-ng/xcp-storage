[Unit]
Description=XCP-ng Storage FIFO read-write lock server (%I)
DefaultDependencies=no

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %t/xcp-storage/locks
ExecStart=/usr/libexec/xcp-storage/xcp-storage-fifo-lock %t/xcp-storage/locks/%I
ExecStopPost=/usr/bin/rm -f %t/xcp-storage/locks/%I
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
